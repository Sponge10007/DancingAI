# ===================================
# 舞蹈视频分析系统 - 环境变量配置
# ===================================
#
# 使用说明:
# 1. 复制此文件为 .env
# 2. 填入你的实际配置值
# 3. 不要将 .env 文件提交到版本控制
#

# 智谱GLM-4.5V API配置
# 获取地址: https://open.bigmodel.cn/
GLM_API_KEY=634bc543a0c940d283cf51a706e9c082.mQ6Vp2sP6gfPGzT0

# 应用配置
DEBUG=true
APP_NAME=舞蹈视频分析系统
VERSION=1.0.0

# 文件上传配置
MAX_FILE_SIZE=524288000  # 500MB (字节)
UPLOAD_DIR=uploads
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.flv

# 视频处理配置
MAX_VIDEO_DURATION=600  # 10分钟 (秒)
FRAME_EXTRACTION_FPS=30
AUDIO_SAMPLE_RATE=22050

# 节拍检测配置
BPM_MIN=60
BPM_MAX=200
BEAT_TRACK_UNITS=time

# 姿态检测配置
POSE_CONFIDENCE_THRESHOLD=0.5
POSE_DETECTION_MODEL=mediapipe

# 数据库配置（可选）
# DATABASE_URL=sqlite:///./dance_analysis.db

# CORS配置
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
