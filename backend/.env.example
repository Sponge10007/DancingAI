# 智谱GLM-4.5V API配置
GLM_API_KEY=your_glm_api_key_here

# 应用配置
DEBUG=true
APP_NAME=舞蹈视频分析系统
VERSION=1.0.0

# 文件上传配置
MAX_FILE_SIZE=524288000  # 500MB
UPLOAD_DIR=uploads

# 视频处理配置
MAX_VIDEO_DURATION=600  # 10分钟
FRAME_EXTRACTION_FPS=30
AUDIO_SAMPLE_RATE=22050

# 节拍检测配置
BPM_MIN=60
BPM_MAX=200

# 姿态检测配置
POSE_CONFIDENCE_THRESHOLD=0.5

# 数据库配置（可选）
# DATABASE_URL=sqlite:///./dance_analysis.db
